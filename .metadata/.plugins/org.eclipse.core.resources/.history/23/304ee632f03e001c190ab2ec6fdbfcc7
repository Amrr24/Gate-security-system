#include "std_types.h"
#include "uart.h"
#include "motor.h"
#include "timer0.h"
#include "buzzer.h"
#include "external_eeprom.h"
#include <avr/delay.h>
void Timer0_Delay(void);
void BUZZER_ON_MIN(void);
uint8  Str1[5] , Str2[5]  ,Str3[5] , Saved_Pass[5];
uint8 Str[20] ;
uint8 warn ;
int i , n  , Buz_state ;
int main (void){
	Timer0_config config = {CLOCK_1024,CTC,0,250};
		Uart_config uart_config = {8,1};
	Buzzer_inint();
	DcMotor_Init();

	UART_init(9600, &uart_config);
	while(1){
		n = UART_recieveByte();
		if (n ==100){
			for (i=0; i<5; i++){
				_delay_ms(10);
				Saved_Pass[i]= UART_recieveByte();

			}
			for (i=0; i<5; i++){
				EEPROM_writeByte(0x0311 + i,Saved_Pass[i]);
			}
		} else if (n==111){
			for (i=0; i<5 ; i++){
				_delay_ms(10);
				Str2[i]= UART_recieveByte();
			}
			for (i=0; i<5 ; i++){
				EEPROM_readByte(0x0311 + i,Str1[i]);
				_delay_ms(10);
			}
			for (i=0 ; i<5; i++){
				if (Str2[i] != Saved_Pass[i] ){
					n = 1 ;
					break ;
				}else {
					n =  0 ;
				}
			}
			if ( n == 0 ){
				UART_sendByte(DOOR_OPEN);
				Dc_Motor_Rotate(Rot_CW , 100);
				Timer0_init(&config);
				Timer0_SetcallBack(&Timer0_Delay);

			}else if (n == 1 ){
				GPIO_setupPinDirection(PORTB_ID, PIN7_ID, PIN_OUTPUT);
				GPIO_writePin(PORTB_ID, PIN7_ID, LOGIC_HIGH);
				UART_sendByte(AGAIN);
continue ;
			}

		}else if (n == BUZZER_ON){
			_delay_ms(10);
			Buz_state = UART_recieveByte();
			if (Buz_state == BUZZER_ON){
				Timer0_init(&config);
				Buzzer_On();
			}
		}else if (n==222){
			for (i=0; i<5 ; i++){
				_delay_ms(10);
				Str3[i]= UART_recieveByte();
			}
			for (i=0; i<5 ; i++){
				EEPROM_readByte(0x0311 + i,Str1[i]);
				_delay_ms(10);
			}
			for (i=0 ; i<5; i++){
				if (Str3[i] != Str1[i] ){
					n = 1 ;
					break ;
				}else {
					n =  0 ;
				}
			}
			_delay_ms(10);
			if (n == 0){
				UART_sendByte(OK);
			}else if (n == 1){
				UART_sendByte(NOT_OK);
				continue ;
			}
		}
	}
	return 0 ;
}
void Timer0_Delay(void){
	int tick = 0 ;
	if (tick == 469){
		Dc_Motor_Rotate(Rot_CW , 0);
	}else if (tick ==562){
		Dc_Motor_Rotate(Rot_A_CW , 100);
	}else if (tick == 1031){
		Dc_Motor_Rotate(Stop, 0);
		Time0_deinit();
	}
	tick ++ ;
}
void BUZZER_ON_MIN(void){
	int tick  = 0 ;
	if (tick == 1875){
		Buzzer_Off();
		Time0_deinit();
	}
	tick ++ ;
}
