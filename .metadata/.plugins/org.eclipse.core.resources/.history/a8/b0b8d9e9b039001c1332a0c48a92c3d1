#include "buzzer.h"
#include "gpio.h"
void Buzzer_inint(void){
	GPIO_setupPinDirection(PORT_BUZZER_ID,PIN_BUZZER_ID,PIN_OUTPUT);

}
void Buzzer_On(void){
	GPIO_writePin(PORT_BUZZER_ID,PIN_BUZZER_ID, LOGIC_HIGH);
}

void Buzzer_Off(void){
	GPIO_writePinPORT_BUZZER_ID,PIN_BUZZER_ID, LOGIC_LOW);
}
