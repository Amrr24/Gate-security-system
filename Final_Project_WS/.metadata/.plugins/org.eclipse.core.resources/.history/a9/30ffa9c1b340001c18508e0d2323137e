#include "std_types.h"
#include "uart.h"
#include "motor.h"
#include "timer0.h"
#include "buzzer.h"
#include "twi.h"
#include "external_eeprom.h"
#include <avr/interrupt.h>
#include <avr/delay.h>

/**********************************************************************************

                              GLOBAL VARIABLES
 ***********************************************************************************/
uint8  Str1[5] , Str2[5]  ,Str3[5] , Saved_Pass[5];// Arrays Used in code to store date and compare , During Matching the password
int i , n  , again ,again1 ,  Buz_state; // n variable used to store the configured bytes that will be received from MC1
int x =0 , y= 0 ; // x,y are variables used for counting how many times the user inserted wrong password
int tick1  = 0 ;//Variable that used in call back door delay function that ticks an increment by 1 every interrupt
int tick2  = 0 ;//Variable that used in call back Buzzer operate  function that ticks an increment by 1 every interrupt
/*******************************************************************************
 *                      Functions Prototypes                                   *
 *******************************************************************************/
void Timer0_Door_Delay(void);
void BUZZER_ON_MIN(void);
/*-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_--_-_-_-__-_

                             FUNCTIONS DEFINATION
 -_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_-_--_-_-_-__-_-_*/
int main (void){
	SREG |= (1<<7); // Enable I-BIT
	I2C_Config TWI_config = {1,400000}; // Configuration of I2C his address 1 , and his Bit rate 400,000 Kbs
	/*
	 * This config of type Timer0_config  used to prescale the clock by dividing it by 1024 and selection of compare
	mode , Initializing the TCNT0 To count from zero , and compare value of 250
	 */
	Timer0_config config = {CLOCK_1024,CTC,0,250};
	Uart_config uart_config = {8,1};// Set DATA bits = 8-bit , Stop_bit = 1 stop bit
	Buzzer_inint(); // Initializing Buzzer driver
	DcMotor_Init(); // Initializing Motor driver
	UART_init(9600, &uart_config);// Set baud rate by 9600
	TWI_init(&TWI_config); // Initializing I2C  driver
	while(1){
		n = UART_recieveByte(); // Always Holds to receive configured byte from MC1
		if (n ==Set_Up_Pass){ // Receiving the configured byte from MC1 about Setting up and storing the new password in EEPROM Memory
			/*
			 * Recieving Password from MC1
			 */
			for (i=0; i<5; i++){
				Saved_Pass[i]= UART_recieveByte(); // RECEIVE byte by byte
			}
			for (i=0; i<5; i++){
				EEPROM_writeByte(0x0311 + i,Saved_Pass[i]); // Store it in EEPROM
				_delay_ms(10);
			}
		} else if (n==Door_state){// Receiving the configured byte from MC1 about opening door senario
			for (i=0; i<5 ; i++){
				Str2[i]= UART_recieveByte(); // Receive inserted password from MC1
			}
			for (i=0; i<5 ; i++){
				EEPROM_readByte(0x0311 + i,Str1[i]);   // Read the stored password
				_delay_ms(10);
			}
			for (i=0 ; i<5; i++){            // Comparing the two passwords
				if (Str2[i] != Saved_Pass[i] ){ // if not match rise n flag by 1
					n = 1 ;
					break ;
				}else {              // if  match rise n flag by 0
					n =  0 ;
				}
			}
			if ( n == 0 ){     // if match send command to MC1 to display door open status
				UART_sendByte(DOOR_OPEN);
				_delay_ms(100);
				Dc_Motor_Rotate(Rot_CW); /* Start the motor to rotate cw for 15s then 3 sec hold
				                          then close after 25 sec using timer driver to handle time
				 */
				Timer0_init(&config); // Initializing
				Timer0_SetcallBack(&Timer0_Door_Delay); // set call back door delay function

			}else if (n == 1 ){ // if not matched
				if (x == 2){ // If the user entered it wrong for 3 times
					Timer0_SetcallBack(&BUZZER_ON_MIN); // set call back for buzzer
					Timer0_init(&config); // init
					Buzzer_On(); // turn on buzzer for 1 min and turn off using timer driver

				}
				again  = AGAIN + x ;
				UART_sendByte(again); // Send command for MC1 about how many times he entered wrong
				_delay_ms(100);
				if (x== 2){
					x =0 ; // clear counter for further operation
				}
				x++ ; // incrementing

			}

		}
		else if (n==Change_Pass_State){// Receiving the configured byte from MC1 about Changing Password senario
			for (i=0; i<5 ; i++){ // receive password from MC1
				Str3[i]= UART_recieveByte(); // byte by byte
			}
			for (i=0; i<5 ; i++){ // read the stored password from EEPROM
				EEPROM_readByte(0x0311 + i,Str1[i]);
				_delay_ms(10);
			}
			for (i=0 ; i<5; i++){ // Compare them
				if (Str3[i] != Saved_Pass[i] ){ // if not matches set flag n =1
					n = 1 ;
					break ;
				}else { // if  matches set flag n =0
					n =  0 ;
				}
			}
			_delay_ms(10);
			if (n == 0){ // if matches
				UART_sendByte(OK); // send command to MC1 to let the user change his set up
				_delay_ms(100);
				continue ;
			}else if (n == 1){ // if not matches
				if (y == 2){ // if the user inserted the password wrong for 3 times
					Timer0_SetcallBack(&BUZZER_ON_MIN); // set call back buzzer function
					Timer0_init(&config); // init it
					Buzzer_On(); // turn on buzzer for 1min and turn off using timer driver
				}
				again1 = NOT_OK + y ;
				UART_sendByte(again1); // Send command for MC1 about how many times he entered the password wrong
				_delay_ms(100);
				if (y== 2){
					y =0 ; // clear counter for further operation
				}
				y++ ; // increment counter by 1

			}
		}
	}
	return 0 ;
}
/*
 * Call back function for door delay Function that is called every interrupt
 As we have choosen prescale 1024 , OCR0 = 250 , therefore new clock is 7812.5 , each clock will take
 0.000128 sec ,   0.000128 sec x 250 , therefore every interrupt will come after 0.032 , therefore each 1 sec will
 come after 31.25 ticks
 */
void Timer0_Door_Delay(void){

	if (tick1 == 469){// AFTER 15 SEC 31.25 X 15 = 468.75 ~ 469
		Dc_Motor_Rotate(Stop); // Stop motor after 3s of operation
	}else if (tick1 ==562){// AFTER 18 SEC 31.25 X 18 = 562.5 ~ 562
		Dc_Motor_Rotate(Rot_A_CW );// re start the motor to rotate in opposite direction for 15s
	}else if (tick1 == 1031){// AFTER 33 SEC 31.25 X 33 = 1031.25 ~ 1031
		Dc_Motor_Rotate(Stop); // Stop the motor
		Time0_deinit();// Disable timer
		tick1 = 0 ; // clear tick times for further opertion
	}
	tick1 ++ ; // increment ticks
}
/*
 * Call back function for Buzzer delay Function that is called every interrupt
 As we have choosen prescale 1024 , OCR0 = 250 , therefore new clock is 7812.5 , each clock will take
 0.000128 sec ,   0.000128 sec x 250 , therefore every interrupt will come after 0.032 , therefore each 1 sec will
 come after 31.25 ticks
 */
void BUZZER_ON_MIN(void){

	if (tick2 == 1875){ // AFTER 1 min = 60 SEC 31.25 X 60 = 1875
		Buzzer_Off(); // Turn off buzzer after 1min of operation
		Time0_deinit();// disable timer
		tick2 = 0 ; // clear ticks for further operation
		x = 0 ; // clear the counted number of the user to enter the password wrong
		y = 0 ;// clear the counted number of the user to enter the password wrong
	}
	tick2 ++ ;// increment ticks
}
