#include <avr/delay.h>
#include "timer0.h"
#include "std_types.h"
#include "lcd.h"
#include "uart.h"
#include "gpio.h"
#include <avr/interrupt.h>
/**********************************************************************************

                              GLOBAL VARIABLES
***********************************************************************************/
uint8 Str1[5] , Str2[5],Str3[5],Str4[5] ;
int n , action  ;
int tick =0 ;
int tick1 = 0 ;
int tick2 = 0 ;
/*******************************************************************************
 *                      Functions Prototypes                                   *
 *******************************************************************************/
void Step1_Change_Pass_Send(void);
void Home(void);
void Open_Door(void);
void Change_Password(void);
void Timer0_Delay(void);
void BUZZER_ON_MIN(void);
/* *******************************************************************************

                             FUNCTIONS DEFINATION
 ********************************************************************************/
int main (void){
	SREG |= (1<<7);
	uint8 Char ;
	LCD_init();
	Uart_config uart_config = {8,1};
	UART_init(9600, &uart_config);
	Step1_Change_Pass_Send();
	Home();
	while (1)
	{
		Char = KEYPAD_getPressedKey();
		switch (Char) {
		case '+' :
			Open_Door();
			break ;
		case '-' :
			Change_Password();
			break ;
		default :

			break ;
		}


	}
	return 0 ;
}

void Step1_Change_Pass_Send(void){
	uint8 Str1[5] , Str2[5] ;
	int i=0 ,j=0 ,z;
	uint8 m ;
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Plz Enter Pass");
	for (i=0 ; i<7; i++ ){
		m= KEYPAD_getPressedKey() ;
		if (m == 13){
			m=0;
			break ;
		}
		Str1[i] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,i,"*");

	}
	_delay_ms(3000);
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Plz ReEnter Pass");
	for (j=0 ; j<7 ; j++ ){
		m = KEYPAD_getPressedKey();
		if ( m == 13){
			m = 0 ;
			break ;

		}
		Str2[j] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,j,"*");

	}
	LCD_clearScreen();

	for (i=0 ; i<5; i++){
		if (Str1[i] != Str2[i] ){
			n =1 ;
			break ;
		}else {
			n =  0 ;
		}
	}
	if (n==0){
		UART_sendByte(100);
		_delay_ms(100);
		for(z=0 ; z<5 ; z++){
			UART_sendByte(Str1[z]);
			_delay_ms(10);
		}
	}else if (n ==1 ) {
		m = 0 ;
		Step1_Change_Pass_Send();

	}

}
void Home(void){
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"+ : Open Door");
	LCD_displayStringRowColumn(1,0,"- : Change Pass");
}
void Open_Door(void){
	int i   ;
	uint8 m ;
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Please Enter Pass");
	_delay_ms(2000);
	for (i =0 ; i<7 ; i++){
		m = KEYPAD_getPressedKey();
		if (m == 13){
			break ;
		}
		Str3[i] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,i,"*");
	}
	UART_sendByte(111);
	_delay_ms(100);
	for(i = 0 ; i < 5 ; i ++){
		UART_sendByte(Str3[i]);
		_delay_ms(10);
	}
	action = UART_recieveByte();
	if (action == DOOR_OPEN){
		LCD_clearScreen();
		LCD_displayStringRowColumn(0,0,"Door Opening");
		Timer0_config config = {CLOCK_1024,CTC,0,250};
		Timer0_init(&config);
		Timer0_SetcallBack(&Timer0_Delay);
	}else if (action == (AGAIN + 2)){
		//_delay_ms(10);
		UART_sendByte(BUZZER_ON);
		// _delay_ms(10);
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0, "ERROR ");
		Timer0_config config = {CLOCK_1024,CTC,0,250};
		Timer0_init(&config);
		Timer0_SetcallBack(&BUZZER_ON_MIN);
		tick = 0 ;
	}else {
		Open_Door();
		tick ++ ;
	}
}
void Change_Password(void){
	int i , action_2 , tick =0  ;
	uint8 m ;
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Please Enter Pass");
	_delay_ms(2000);
	for (i=0 ; i<7 ; i++){
		m = KEYPAD_getPressedKey();
		if (m == 13){
			break ;
		}
		Str4[i] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,i,"*");
	}
	UART_sendByte(222);
	_delay_ms(100);
	for (i = 0 ; i <5 ; i ++){
		UART_sendByte(Str4[i]);
		_delay_ms(10);
	}
	action_2 = UART_recieveByte();
	if (action_2 == OK){
		Step1_Change_Pass_Send() ;

	}else if (action_2 == (NOT_OK + 2 )){
		UART_sendByte(BUZZER_ON);
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0, "ERROR ");
		Timer0_config config = {CLOCK_1024,CTC,0,250};
		Timer0_init(&config);
		Timer0_SetcallBack(&BUZZER_ON_MIN);
		tick = 0 ;
	}else {
		Change_Password();
		tick ++ ;
	}
}
void Timer0_Delay(void){

	if (tick1 == 469){
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0,"Door Opened");
	}else if (tick1 == 562){
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0,"Door Closing");
	}else if (tick1 == 1031){
		Time0_deinit();
		Home();
		tick1 = 0 ;
	}
	tick1 ++ ;
}
void BUZZER_ON_MIN(void){

	if (tick2 == 1875){
		Home();
		Time0_deinit();
	}
	tick2 ++ ;
}
