#include <avr/interrupt.h>
/**********************************************************************************

                              GLOBAL VARIABLES
 ***********************************************************************************/
uint8 Str1[5] , Str2[5],Str3[5],Str4[5] ; // Arrays Used in code to store date and compare , During Matching the password
uint8 n  ; // Variable That used as flag sets to 1 when mismatch happens and 0 if match
int tick1 = 0 ; //Variable that used in call back door delay function that ticks an increment by 1 every interrupt
int tick2 = 0 ;//Variable that used in call back Buzzer operate  function that ticks an increment by 1 every interrupt
/*******************************************************************************
 *                      Functions Prototypes                                   *
 *******************************************************************************/
void Step1_Change_Pass_Send(void);
void Home(void);
void Open_Door(void);
void Change_Password(void);
void Timer0_Door_Delay(void);
void BUZZER_ON_MIN(void);
/* *******************************************************************************

                             FUNCTIONS DEFINATION
 ********************************************************************************/
int main (void){
	SREG |= (1<<7); // Enable I-Bit
	uint8 Char ; // Local Variable that Always gets inside it the value of pressed key
	LCD_init(); // Initialize Lcd Driver
	Uart_config uart_config = {8,1}; // Set DATA bits = 8-bit , Stop_bit = 1 stop bit
	UART_init(9600, &uart_config); // Set baud rate by 9600
	Step1_Change_Pass_Send(); // Call Function needed first to insert your new password
	Home(); // Call home function that display options available
	while (1)
	{
		Char = KEYPAD_getPressedKey(); // Get pressed key whether '+' or '-'
		switch (Char) {
		case '+' : // In case of User selected to Open door
			Open_Door(); //  Call open door function
			break ;
		case '-' :// In case of User selected to Change Password
			Change_Password(); //  Call Change Password Function
			break ;
		default :
			break ;
		}


	}
	return 0 ;
}
/*
 * This Function "Step1_Change_Pass_Send" Used to Set up initially Your desired Password
  and it will ask you to insert it 2 times and has to be confirmed , i.e Has to match
 if it matches it will be stored in EEPROM Memory for further needs and if not it will ask you for
 setting it up again till it matches
 */
void Step1_Change_Pass_Send(void){
	 // uint8 Str1[5] , Str2[5] ;
	int i=0 ,j=0 ,z=0;
	uint8 m =0  ;
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Plz Enter Pass");
	for (i=0 ; i<7; i++ ){
		_delay_ms(1500);
		m= KEYPAD_getPressedKey() ;
		if (m == 13 ){
			break ;
		}
		Str1[i] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,i,"*");
	}
	_delay_ms(3000);
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Plz ReEnter Pass");
	for (j=0 ; j<7 ; j++ ){
		m = KEYPAD_getPressedKey();
		if ( m == 13){
			break ;
		}
		Str2[j] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,j,"*");
	}
	LCD_clearScreen();
	for (i=0 ; i<5; i++){
		if (Str1[i] != Str2[i] ){
			n =1 ;
			break ;
		}else {
			n =  0 ;
		}
	}
	if (n==0){
		UART_sendByte(100);
		_delay_ms(100);
		for(z=0 ; z<5 ; z++){
			UART_sendByte(Str1[z]);
			_delay_ms(10);
		}
	}else if (n ==1 ) {
		Step1_Change_Pass_Send();
	}
}
void Home(void){
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"+ : Open Door");
	LCD_displayStringRowColumn(1,0,"- : Change Pass");
}
void Open_Door(void){
	int i  , action  ;
	uint8 m ;
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Please Enter Pass");
	_delay_ms(2000);
	for (i =0 ; i<7 ; i++){
		m = KEYPAD_getPressedKey();
		if (m == 13){
			break ;
		}
		Str3[i] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,i,"*");
	}
	UART_sendByte(111);
	_delay_ms(100);
	for(i = 0 ; i < 5 ; i ++){
		UART_sendByte(Str3[i]);
		_delay_ms(10);
	}
	action = UART_recieveByte();
	if (action == DOOR_OPEN){
		LCD_clearScreen();
		LCD_displayStringRowColumn(0,0,"Door Opening");
		Timer0_config config = {CLOCK_1024,CTC,0,250};
		Timer0_init(&config);
		Timer0_SetcallBack(&Timer0_Door_Delay);
	}else if (action == (AGAIN + 2)){
		//_delay_ms(10);
		UART_sendByte(BUZZER_ON);
		// _delay_ms(10);
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0, "ERROR ");
		LCD_displayStringRowColumn(1, 0, "WRONG PASSWORD");
		Timer0_config config = {CLOCK_1024,CTC,0,250};
		Timer0_init(&config);
		Timer0_SetcallBack(&BUZZER_ON_MIN);
	}else {
		Open_Door();
	}
}
void Change_Password(void){
	int i , action_2 , tick =0  ;
	uint8 m ;
	LCD_clearScreen();
	LCD_displayStringRowColumn(0,0,"Please Enter Pass");
	_delay_ms(2000);
	for (i=0 ; i<7 ; i++){
		m = KEYPAD_getPressedKey();
		if (m == 13){
			break ;
		}
		Str4[i] = m;
		_delay_ms(3000);
		LCD_displayStringRowColumn(1,i,"*");
	}
	UART_sendByte(222);
	_delay_ms(100);
	for (i = 0 ; i <5 ; i ++){
		UART_sendByte(Str4[i]);
		_delay_ms(10);
	}
	action_2 = UART_recieveByte();
	if (action_2 == OK){
		Step1_Change_Pass_Send() ;

	}else if (action_2 == (NOT_OK + 2 )){
		UART_sendByte(BUZZER_ON);
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0, "ERROR ");
		Timer0_config config = {CLOCK_1024,CTC,0,250};
		Timer0_init(&config);
		Timer0_SetcallBack(&BUZZER_ON_MIN);

	}else {
		Change_Password();

	}
}
void Timer0_Door_Delay(void){

	if (tick1 == 469){
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0,"Door Opened");
	}else if (tick1 == 562){
		LCD_clearScreen();
		LCD_displayStringRowColumn(0, 0,"Door Closing");
	}else if (tick1 == 1031){
		Time0_deinit();
		Home();
		tick1 = 0 ;
	}
	tick1 ++ ;
}
void BUZZER_ON_MIN(void){

	if (tick2 == 1875){
		Home();
		Time0_deinit();
	}
	tick2 ++ ;
}
