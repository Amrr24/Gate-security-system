#include "std_types.h"
#include "uart.h"
#include "motor.h"
#include "timer0.h"
#include "buzzer.h"
#include "twi.h"
#include "external_eeprom.h"
#include <avr/interrupt.h>
#include <avr/delay.h>
void Timer0_Delay(void);
void BUZZER_ON_MIN(void);
uint8  Str1[5] , Str2[5]  ,Str3[5] , Saved_Pass[5];
uint8 Str[20] ;
uint8 warn ;
int i , n  , Buz_state ,rep= 0  ;
int tick1  = 0 ;
int tick2  = 0 ;
int main (void){
	SREG |= (1<<7);
	I2C_Config TWI_config = {1,400000};
	Timer0_config config = {CLOCK_1024,CTC,0,250};
		Uart_config uart_config = {8,1};
	Buzzer_inint();
	DcMotor_Init();
	UART_init(9600, &uart_config);
	TWI_init(&TWI_config);
	while(1){
		n = UART_recieveByte();
		if (n ==100){
			for (i=0; i<5; i++){
				// _delay_ms(10);
				Saved_Pass[i]= UART_recieveByte();

			}
			for (i=0; i<5; i++){
				EEPROM_writeByte(0x0311 + i,Saved_Pass[i]);
				_delay_ms(10);
			}
		} else if (n==111){
			for (i=0; i<5 ; i++){
				// _delay_ms(10);
				Str2[i]= UART_recieveByte();
			}
			for (i=0; i<5 ; i++){
				EEPROM_readByte(0x0311 + i,Str1[i]);
				_delay_ms(10);
			}
			for (i=0 ; i<5; i++){
				if (Str2[i] != Saved_Pass[i] ){
					n = 1 ;
					break ;
				}else {
					n =  0 ;
				}
			}
			if ( n == 0 ){
				UART_sendByte(DOOR_OPEN);
				_delay_ms(100);
				Dc_Motor_Rotate(Rot_CW);
				Timer0_init(&config);
				Timer0_SetcallBack(&Timer0_Delay);

			}else if (n == 1 ){
				UART_sendByte(AGAIN);
				_delay_ms(100);
				if (rep == 2){

					Timer0_SetcallBack(&BUZZER_ON_MIN);
									Timer0_init(&config);
									Buzzer_On();
									rep =0 ;
				}
rep ++ ;
			}

		}/*else if (n == BUZZER_ON){
			Buz_state = UART_recieveByte();
			if (Buz_state == BUZZER_ON){
				Timer0_SetcallBack(&BUZZER_ON_MIN);
				Timer0_init(&config);
				Buzzer_On();
			}
		}*/else if (n==222){
			for (i=0; i<5 ; i++){
				//_delay_ms(10);
				Str3[i]= UART_recieveByte();
			}
			for (i=0; i<5 ; i++){
				EEPROM_readByte(0x0311 + i,Str1[i]);
				_delay_ms(10);
			}
			for (i=0 ; i<5; i++){
				if (Str3[i] != Saved_Pass[i] ){
					n = 1 ;
					break ;
				}else {
					n =  0 ;
				}
			}
			_delay_ms(10);
			if (n == 0){
				UART_sendByte(OK);
				_delay_ms(100);
				continue ;
			}else if (n == 1){
				UART_sendByte(NOT_OK);
				_delay_ms(100);
				continue ;
			}
		}
	}
	return 0 ;
}
void Timer0_Delay(void){

	if (tick1 == 469){
		Dc_Motor_Rotate(Stop);
	}else if (tick1 ==562){
		Dc_Motor_Rotate(Rot_A_CW );
	}else if (tick1 == 1031){
		Dc_Motor_Rotate(Stop);
		Time0_deinit();
		tick1 = 0 ;
	}
	tick1 ++ ;
}
void BUZZER_ON_MIN(void){

	if (tick2 == 1875){
		Buzzer_Off();
		Time0_deinit();
		tick2 = 0 ;
		rep = 0 ;
	}
	tick2 ++ ;
}
